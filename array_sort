}

for(i=0; i<arr.length; i++) {
print(arr[i], " ");
}

println("");

for(i=0; i<arr.length; i++) {
max = index = -1;

for(j=0; j<arr.length-i; j++) {
if(max < arr[j]) {
index = j;
max = arr[j];
}
}

tmp = arr[arr.length-i-1];
arr[arr.length-i-1] = max;
arr[index] = tmp;
}

for(i=0; i<arr.length; i++) {
print(arr[i], " ");
}
}

